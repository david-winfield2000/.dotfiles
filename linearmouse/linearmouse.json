{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.11.4",
  "schemes" : [
    {
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0xc077",
          "productName" : "USB Optical Mouse",
          "vendorID" : "0x46d"
        }
      },
      "pointer" : {
        "acceleration" : 0.8,
        "disableAcceleration" : true
      },
      "scrolling" : {
        "acceleration" : {
          "vertical" : 1
        },
        "distance" : {
          "vertical" : 7
        },
        "reverse" : {
          "vertical" : true
        },
        "smoothed" : {
          "vertical" : {
            "enabled" : false
          }
        },
        "speed" : {
          "vertical" : 0
        }
      }
    }
  ]
}
